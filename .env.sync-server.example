# Copy to .env.sync-server on the droplet (not committed).
# Must match the network your Caddy container is on:
#   docker inspect caddy --format '{{range $k,$v := .NetworkSettings.Networks}}{{$k}}{{"\n"}}{{end}}'
CODEX_SYNC_DOCKER_NETWORK=headscale_default

# Same Neon (or Docker Postgres) URL as the web app — enables durable Yjs + invites.
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
